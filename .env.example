# Required for real JEV calls (get a key at https://console.typesafe.ai/keys)
TYPESAFE_API_KEY=

# Optional: raises NCBI rate limit from 3/s to 10/s
NCBI_API_KEY=

# Optional: VEuPathDB service API requires a registered-user key (release 71+).
# Without it we fall back to NCBI, which indexes VEuPathDB locus tags.
# Get one at https://veupathdb.org user profile -> service access.
VEUPATHDB_API_KEY=

# Optional: cache dir for API + JEV responses (default: no cache)
BIONYM_CACHE_DIR=

# Optional: LLM for claim enumeration (datasets/publications -> proposals
# that JEV then scores). Any OpenAI-compatible endpoint: OpenRouter,
# OpenAI, Gemini compat, local vLLM/Ollama. Disabled when unset.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=

# Proposal pipeline tuning: JEV triage score (0-1) a dataset/publication
# needs before the LLM spends a call on it, and max simultaneous LLM calls.
BIONYM_PROPOSAL_MIN_SCORE=0.5
BIONYM_PROPOSAL_CONCURRENCY=8

# Optional: alternate systemone judge endpoint. Laya/Kev/CLM all
# speak POST /v1/systemone. Default: https://api.typesafe.ai
JEV_BASE_URL=

# Optional: LLM request timeout, seconds (default 180)
LLM_TIMEOUT=

# Server (backend/) only: permit ?mock_jev=true on API requests.
# Offline dev/evals only — mock answers are not meaningful.
BIONYM_ALLOW_MOCK=

# Server only: comma-separated CORS origins (default http://localhost:8080)
BIONYM_CORS_ORIGINS=
